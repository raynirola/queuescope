{
  "name": "queuescope",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test packages/node/*.test.mjs && node --conditions=react-server --test packages/next/*.test.mjs",
    "test:packages": "node scripts/test-adapter-packages.mjs",
    "test:bridge": "npm test --workspace bullmq-action-bridge",
    "test:release": "python3 -B -m unittest discover -s tests/release -v"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "bullmq": "5.77.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
